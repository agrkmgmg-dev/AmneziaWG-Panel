# =====================================================
# AmneziaWG-Panel Environment Configuration
# Release 0.1 Foundation
# =====================================================


# Application

APP_NAME=AmneziaWG-Panel

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=true


# Server

HOST=0.0.0.0

PORT=8000


# Security

SECRET_KEY=change_this_to_a_secure_random_secret_key

JWT_ALGORITHM=HS256

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

SESSION_TIMEOUT_MINUTES=60


# Database

DATABASE_URL=sqlite:///./amnezia_panel.db


# Logging

LOG_LEVEL=INFO

LOG_FILE=logs/app.log


# AmneziaWG

AWG_INTERFACE=awg0

AWG_CONFIG_PATH=/etc/amnezia/amneziawg/awg0.conf

AWG_AUTO_SYNC=false


# Docker

DOCKER_ENABLED=true

DOCKER_SOCKET=/var/run/docker.sock

AWG_CONTAINER_NAME=amnezia-awg


# QR Code

QR_CODE_SIZE=300


# Traffic Monitoring

TRAFFIC_MONITOR_ENABLED=true

TRAFFIC_UNIT=GB


# Security Features

ENABLE_CSRF=true

ENABLE_ACTIVITY_LOG=true


# Initial Admin

ADMIN_USERNAME=admin

ADMIN_EMAIL=admin@example.com

ADMIN_PASSWORD=change_this_password